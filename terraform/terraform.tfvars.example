# Copy to terraform.tfvars (git-ignored) and adjust. Credentials never go here:
# Terraform reads them from your AWS CLI profile or environment.
region              = "ap-south-1"
cluster_name        = "seatlock-demo"
cluster_version     = "1.35"
github_repository   = "your-github-user/seatlock"
node_instance_types = ["t3.medium"]
node_desired_size   = 2

# Narrow this to your IP (x.x.x.x/32) if you deploy only from your laptop.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]
